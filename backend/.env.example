# SwipeTurn Backend Environment Configuration Template
# Duplicate this file to .env and fill in the values for production.

# Supabase Configuration
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Clerk Configuration
CLERK_SECRET_KEY=your_clerk_secret_key
CLERK_PEM_KEY=your_clerk_pem_key

# AI Configuration
OPENROUTER_API_KEY=your_openrouter_api_key

# Production Readiness
# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=https://swipeturn.com,https://www.swipeturn.com,https://api.swipeturn.com
