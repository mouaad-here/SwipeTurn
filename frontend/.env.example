EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Backend API URL. Must match the port the backend runs on.
# For iOS Simulator / web: http://localhost:8000 (or 8001 if backend runs on 8001)
# For Android Emulator: http://10.0.2.2:8000
# For physical device: http://YOUR_PC_IP:8000 (e.g. http://192.168.1.10:8000)
EXPO_PUBLIC_API_URL=

# Backend: required for CV parsing (LLM extracts skills from uploaded CV). Get a key at https://openrouter.ai


# Optional (backend .env): FREE_SWIPE_LIMIT=10 for production; default 999 for testing.
